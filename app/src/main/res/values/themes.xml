<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Normal (non-fullscreen) theme: the system status bar and navigation
         bar stay visible; we never go edge-to-edge/immersive. -->
    <style name="Theme.Muufi" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/accent</item>
    </style>
</resources>
